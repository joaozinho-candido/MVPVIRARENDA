# ---------------------------------------------------------------
# Vira Renda · variáveis de ambiente (copie para .env.local)
# ---------------------------------------------------------------

# URL pública do site (usada nos links dos e-mails)
APP_URL=http://localhost:3000

# Banco de dados
# - Vazio: usa PGlite (Postgres embutido) em ./.data/pglite — ideal para desenvolvimento.
# - Produção: string de conexão Postgres. No Supabase, use a "Connection string" do pooler (porta 6543).
DATABASE_URL=
# PGLITE_DIR=.data/pglite
# DATABASE_POOL_MAX=5

# Administrador inicial criado pelo `npm run db:seed` (obrigatório em produção)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Pagamentos
# Segredo HMAC usado para validar webhooks (troque em produção; gere com `openssl rand -hex 32`)
PAYMENT_WEBHOOK_SECRET=
# Segredo do endpoint diário /api/cron/billing (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Caixa de e-mails de desenvolvimento em /dev/emails (true só em ambientes de teste)
DEV_MAILBOX=false

# Dados exibidos no rodapé, termos e privacidade (preencher antes do lançamento)
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
COMPANY_NAME=
COMPANY_CNPJ=
DPO_EMAIL=
